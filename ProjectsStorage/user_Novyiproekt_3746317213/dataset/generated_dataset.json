[["\u041e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u0438\u0432\u0435\u0442\u043b\u0438\u0432\u044b\u043c, \u043d\u043e \u0438\u043d\u0442\u0435\u0440\u044c\u0435\u0440 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b \u0436\u0435\u043b\u0430\u0442\u044c \u043b\u0443\u0447\u0448\u0435\u0433\u043e.", {"\u041e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435": "Positive", "\u0438\u043d\u0442\u0435\u0440\u044c\u0435\u0440": "Negative"}], ["\u0412\u043a\u0443\u0441 \u0431\u043b\u044e\u0434 \u0431\u044b\u043b \u0432\u043e\u0441\u0445\u0438\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c, \u0430 \u0446\u0435\u043d\u044b \u0432\u043f\u043e\u043b\u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c\u0438.", {"\u0412\u043a\u0443\u0441": "Positive", "\u0446\u0435\u043d\u044b": "Positive"}], ["\u041a\u0443\u0445\u043d\u044f \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430 \u043f\u0440\u0435\u0432\u0437\u043e\u0448\u043b\u0430 \u0432\u0441\u0435 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f, \u043d\u043e \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u043b\u043e \u0436\u0435\u043b\u0430\u0442\u044c \u043b\u0443\u0447\u0448\u0435\u0433\u043e.", {"\u041a\u0443\u0445\u043d\u044f": "Positive", "\u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435": "Negative"}], ["\u041a\u0443\u0445\u043d\u044f \u0437\u0434\u0435\u0441\u044c \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u043d\u0430\u044f, \u043d\u043e \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0436\u0435\u043b\u0430\u0442\u044c \u043b\u0443\u0447\u0448\u0435\u0433\u043e.", {"\u041a\u0443\u0445\u043d\u044f": "Positive", "\u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435": "Negative"}], ["\u0418\u043d\u0442\u0435\u0440\u044c\u0435\u0440 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430 \u0441\u043e\u0437\u0434\u0430\u0435\u0442 \u0443\u044e\u0442\u043d\u0443\u044e \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443, \u043d\u043e \u0446\u0435\u043d\u044b \u043d\u0430 \u0431\u043b\u044e\u0434\u0430 \u043a\u0430\u0436\u0443\u0442\u0441\u044f \u0437\u0430\u0432\u044b\u0448\u0435\u043d\u043d\u044b\u043c\u0438.", {"\u0418\u043d\u0442\u0435\u0440\u044c\u0435\u0440": "Positive", "\u0446\u0435\u043d\u044b": "Negative"}], ["\u0425\u043e\u0442\u044f \u043a\u0443\u0445\u043d\u044f \u043d\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0430 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u044f, \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0441\u0434\u0435\u043b\u0430\u043b\u0430 \u0432\u0435\u0447\u0435\u0440 \u043d\u0435\u0437\u0430\u0431\u044b\u0432\u0430\u0435\u043c\u044b\u043c.", {"\u043a\u0443\u0445\u043d\u044f": "Negative", "\u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f": "Positive"}], ["\u0412\u043a\u0443\u0441 \u0431\u043b\u044e\u0434 \u0431\u044b\u043b \u0441\u0440\u0435\u0434\u043d\u0438\u043c, \u043d\u043e \u044d\u0442\u043e \u043d\u0435 \u043f\u043e\u043c\u0435\u0448\u0430\u043b\u043e \u043d\u0430\u043c \u0445\u043e\u0440\u043e\u0448\u043e \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0432\u0440\u0435\u043c\u044f.", {"\u0412\u043a\u0443\u0441 \u0431\u043b\u044e\u0434": "Neutral", "\u0432\u0440\u0435\u043c\u044f": "Positive"}], ["\u041a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0438\u0449\u0438 \u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u043e \u0432\u043e\u0441\u0442\u043e\u0440\u0433\u0430, \u043e\u0434\u043d\u0430\u043a\u043e \u043e\u0431\u0449\u0438\u0439 \u0432\u0435\u0447\u0435\u0440 \u0431\u044b\u043b \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u044b\u043c.", {"\u041a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0438\u0449\u0438": "Negative", "\u0432\u0435\u0447\u0435\u0440": "Positive"}], ["\u0415\u0434\u0430 \u0432 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0435 \u043d\u0435 \u043e\u0442\u043b\u0438\u0447\u0430\u043b\u0430\u0441\u044c \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u043d\u043e\u0441\u0442\u044c\u044e, \u043d\u043e \u044d\u0442\u043e \u043d\u0435 \u043e\u043c\u0440\u0430\u0447\u0438\u043b\u043e \u043d\u0430\u0448\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435.", {"\u0415\u0434\u0430": "Negative", "\u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435": "Positive"}], ["\u0411\u043b\u044e\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b\u0438 \u0448\u0435\u0434\u0435\u0432\u0440\u043e\u043c \u043a\u0443\u043b\u0438\u043d\u0430\u0440\u0438\u0438, \u043d\u043e \u0432\u0435\u0447\u0435\u0440 \u0432 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0435 \u0432\u0441\u0435 \u0440\u0430\u0432\u043d\u043e \u0443\u0434\u0430\u043b\u0441\u044f.", {"\u0411\u043b\u044e\u0434\u0430": "Negative", "\u0432\u0435\u0447\u0435\u0440": "Positive"}], ["\u041a\u0443\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0435 \u0438\u0437\u044b\u0441\u043a\u0438 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0438 \u0436\u0435\u043b\u0430\u0442\u044c \u043b\u0443\u0447\u0448\u0435\u0433\u043e, \u043d\u043e \u0432\u0435\u0447\u0435\u0440 \u043f\u0440\u043e\u0448\u0435\u043b \u043e\u0442\u043b\u0438\u0447\u043d\u043e.", {"\u041a\u0443\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0435 \u0438\u0437\u044b\u0441\u043a\u0438": "Negative", "\u0432\u0435\u0447\u0435\u0440": "Positive"}], ["\u0415\u0434\u0430 \u0431\u044b\u043b\u0430 \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0440\u043e\u0448\u0430, \u043d\u043e \u044d\u0442\u043e \u043d\u0435 \u043f\u043e\u043c\u0435\u0448\u0430\u043b\u043e \u043d\u0430\u043c \u043d\u0430\u0441\u043b\u0430\u0434\u0438\u0442\u044c\u0441\u044f \u0432\u0435\u0447\u0435\u0440\u043e\u043c \u0432 \u043f\u043e\u043b\u043d\u043e\u0439 \u043c\u0435\u0440\u0435.", {"\u0415\u0434\u0430": "Positive"}], ["\u0412\u043a\u0443\u0441\u043e\u0432\u044b\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0431\u043b\u044e\u0434 \u043d\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0438\u043b\u0438, \u043d\u043e \u043e\u0431\u0449\u0435\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435 \u043e\u0442 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430 \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c.", {"\u0412\u043a\u0443\u0441\u043e\u0432\u044b\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0431\u043b\u044e\u0434": "Negative", "\u043e\u0431\u0449\u0435\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435": "Positive"}], ["\u0425\u043e\u0442\u044f \u0435\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b\u0430 \u0432\u044b\u0434\u0430\u044e\u0449\u0435\u0439\u0441\u044f, \u0432\u0435\u0447\u0435\u0440 \u0432 \u044d\u0442\u043e\u043c \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0435 \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u043b\u0441\u044f \u043a\u0430\u043a \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439.", {"\u0435\u0434\u0430": "Negative", "\u0432\u0435\u0447\u0435\u0440": "Positive"}], ["\u0417\u0434\u0435\u0441\u044c \u043a\u0430\u0436\u0434\u044b\u0439 \u0431\u043b\u044e\u0434\u043e - \u044d\u0442\u043e \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0430, \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u0435 \u0440\u0443\u043a\u0430\u043c\u0438 \u0442\u0430\u043b\u0430\u043d\u0442\u043b\u0438\u0432\u044b\u0445 \u043f\u043e\u0432\u0430\u0440\u043e\u0432.", {"\u0431\u043b\u044e\u0434\u043e": "Positive", "\u043f\u043e\u0432\u0430\u0440\u043e\u0432": "Positive"}], ["\u041e\u0442\u043c\u0435\u043d\u043d\u0430\u044f \u043a\u0443\u0445\u043d\u044f \u044d\u0442\u043e\u0433\u043e \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0430\u043c\u044b\u0435 \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u044f.", {"\u043a\u0443\u0445\u043d\u044f": "Positive"}], ["\u041f\u043e\u0432\u0430\u0440\u0430 \u0432 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0435 \u0443\u043c\u0435\u044e\u0442 \u0443\u0434\u0438\u0432\u043b\u044f\u0442\u044c, \u0438\u0445 \u043a\u0443\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0435 \u0448\u0435\u0434\u0435\u0432\u0440\u044b \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u044e\u0442 \u0432\u044b\u0441\u0448\u0438\u0445 \u043f\u043e\u0445\u0432\u0430\u043b.", {"\u041f\u043e\u0432\u0430\u0440\u0430": "Positive", "\u043a\u0443\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0435 \u0448\u0435\u0434\u0435\u0432\u0440\u044b": "Positive"}], ["\u0412\u043a\u0443\u0441\u043e\u0432\u0430\u044f \u0433\u0430\u043c\u043c\u0430 \u0431\u043b\u044e\u0434 \u0432 \u044d\u0442\u043e\u043c \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u043f\u043e\u0440\u0430\u0436\u0430\u0435\u0442, \u043f\u043e\u0432\u0430\u0440\u0430 - \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u043c\u0430\u0441\u0442\u0435\u0440\u0430 \u0441\u0432\u043e\u0435\u0433\u043e \u0434\u0435\u043b\u0430.", {"\u0412\u043a\u0443\u0441\u043e\u0432\u0430\u044f \u0433\u0430\u043c\u043c\u0430": "Positive", "\u043f\u043e\u0432\u0430\u0440\u0430": "Positive"}], ["\u041a\u0430\u0436\u0434\u044b\u0439 \u0432\u0438\u0437\u0438\u0442 \u0432 \u044d\u0442\u043e\u0442 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d - \u044d\u0442\u043e \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u043a \u0434\u043b\u044f \u0433\u0443\u0440\u043c\u0430\u043d\u0430, \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0431\u0435\u0437\u0443\u043f\u0440\u0435\u0447\u043d\u043e\u0439 \u043a\u0443\u0445\u043d\u0435.", {"\u043a\u0443\u0445\u043d\u0435": "Positive"}], ["\u0428\u0435\u0444-\u043f\u043e\u0432\u0430\u0440 \u0438 \u0435\u0433\u043e \u043a\u043e\u043c\u0430\u043d\u0434\u0430 \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u043d\u043e \u0441\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u0440\u0430\u0431\u043e\u0442\u043e\u0439, \u043a\u0443\u0445\u043d\u044f \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u043b\u0443\u0447\u0448\u0438\u0445 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u043e\u0432.", {"\u0428\u0435\u0444-\u043f\u043e\u0432\u0430\u0440": "Positive", "\u043a\u043e\u043c\u0430\u043d\u0434\u0430": "Positive", "\u043a\u0443\u0445\u043d\u044f": "Positive"}], ["\u042d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u043e\u0441\u0442\u044c \u0438 \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u043d\u043e\u0441\u0442\u044c \u0431\u043b\u044e\u0434 \u0432 \u044d\u0442\u043e\u043c \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u044f\u0442 \u0441\u0430\u043c\u0438 \u0437\u0430 \u0441\u0435\u0431\u044f, \u043f\u043e\u0432\u0430\u0440\u0430 - \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u0445\u0443\u0434\u043e\u0436\u043d\u0438\u043a\u0438.", {"\u0431\u043b\u044e\u0434": "Positive", "\u043f\u043e\u0432\u0430\u0440\u0430": "Positive"}], ["\u041d\u0435\u0436\u043d\u044b\u0435 \u0432\u043a\u0443\u0441\u044b \u0438 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0435 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0435 \u0438\u043d\u0433\u0440\u0435\u0434\u0438\u0435\u043d\u0442\u043e\u0432 \u0434\u0435\u043b\u0430\u044e\u0442 \u043a\u0443\u0445\u043d\u044e \u044d\u0442\u043e\u0433\u043e \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430 \u043f\u043e\u0438\u0441\u0442\u0438\u043d\u0435 \u0432\u0435\u043b\u0438\u043a\u043e\u043b\u0435\u043f\u043d\u043e\u0439.", {"\u0432\u043a\u0443\u0441\u044b": "Positive", "\u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0435": "Positive", "\u043a\u0443\u0445\u043d\u044e": "Positive"}], ["\u0412\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0435 \u0443\u0431\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u043b\u043e\u0441\u044c, \u043d\u043e \u0435\u0434\u0430 \u0431\u044b\u043b\u0430 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0439, \u043a\u0430\u043a \u0438 \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u043b\u043e\u0441\u044c.", {"\u0412\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0435 \u0443\u0431\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f": "Positive", "\u0435\u0434\u0430": "Neutral"}], ["\u041e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u043e \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u044d\u043c\u043e\u0446\u0438\u0438, \u0432 \u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0430\u043a \u043a\u0443\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0435 \u0438\u0437\u044b\u0441\u043a\u0438 \u043d\u0435 \u043f\u0440\u0435\u0432\u0437\u043e\u0448\u043b\u0438 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u0439.", {"\u041e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430": "Positive", "\u043a\u0443\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0435 \u0438\u0437\u044b\u0441\u043a\u0438": "Neutral"}], ["\u042d\u043a\u0441\u0442\u0435\u0440\u044c\u0435\u0440 \u0438 \u0438\u043d\u0442\u0435\u0440\u044c\u0435\u0440 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u043b\u0438 \u0445\u043e\u0440\u043e\u0448\u0435\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435, \u043e\u0434\u043d\u0430\u043a\u043e \u043a\u0443\u0445\u043d\u044f \u043d\u0435 \u0443\u0434\u0438\u0432\u0438\u043b\u0430, \u043e\u0441\u0442\u0430\u0432\u0430\u044f\u0441\u044c \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 \u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f.", {"\u042d\u043a\u0441\u0442\u0435\u0440\u044c\u0435\u0440 \u0438 \u0438\u043d\u0442\u0435\u0440\u044c\u0435\u0440 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430": "Positive", "\u043a\u0443\u0445\u043d\u044f": "Neutral"}], ["\u0412\u043f\u0435\u0447\u0430\u0442\u043b\u0438\u043b \u0438\u043d\u0442\u0435\u0440\u044c\u0435\u0440, \u043d\u043e \u0432\u043a\u0443\u0441 \u0431\u043b\u044e\u0434 \u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b \u0432\u043e\u0441\u0442\u043e\u0440\u0433\u0430, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044f \u0446\u0435\u043d\u043e\u0432\u043e\u0439 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438.", {"\u0438\u043d\u0442\u0435\u0440\u044c\u0435\u0440": "Positive", "\u0432\u043a\u0443\u0441 \u0431\u043b\u044e\u0434": "Neutral"}], ["\u0418\u043d\u0442\u0435\u0440\u044c\u0435\u0440 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430 \u0431\u044b\u043b \u043d\u0430 \u0432\u044b\u0441\u043e\u0442\u0435, \u043d\u043e \u043a\u0443\u043b\u0438\u043d\u0430\u0440\u043d\u043e\u0435 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e \u043d\u0435 \u043f\u0440\u0435\u0432\u0437\u043e\u0448\u043b\u043e \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u0439, \u043e\u0441\u0442\u0430\u0432\u0430\u044f\u0441\u044c \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u043e\u0431\u044b\u0434\u0435\u043d\u043d\u043e\u0433\u043e.", {"\u0418\u043d\u0442\u0435\u0440\u044c\u0435\u0440 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430": "Positive", "\u043a\u0443\u043b\u0438\u043d\u0430\u0440\u043d\u043e\u0435 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e": "Neutral"}], ["\u0414\u0438\u0437\u0430\u0439\u043d \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043f\u043e\u043d\u0440\u0430\u0432\u0438\u043b\u0441\u044f, \u043d\u043e \u0435\u0434\u0430 \u043d\u0435 \u043e\u0442\u043b\u0438\u0447\u0430\u043b\u0430\u0441\u044c \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u043d\u043e\u0441\u0442\u044c\u044e, \u0447\u0442\u043e \u0431\u044b\u043b\u043e \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043d\u043e\u0440\u043c\u044b \u0434\u043b\u044f \u0434\u0430\u043d\u043d\u043e\u0433\u043e \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430.", {"\u0414\u0438\u0437\u0430\u0439\u043d \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f": "Positive", "\u0435\u0434\u0430": "Neutral"}], ["\u041e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430 \u0437\u0430\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u0445\u0432\u0430\u043b\u044b, \u043d\u043e \u043a\u0443\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0435\u043d\u0438\u044f \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c \u043d\u0435\u0432\u043e\u0441\u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438, \u0442\u0430\u043a \u043a\u0430\u043a \u043d\u0435 \u0432\u044b\u0448\u043b\u0438 \u0437\u0430 \u0440\u0430\u043c\u043a\u0438 \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u043e\u0433\u043e.", {"\u041e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430": "Positive", "\u043a\u0443\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0442\u0435\u043d\u0438\u044f": "Neutral"}], ["\u0412\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u044f \u043e\u0442 \u0438\u043d\u0442\u0435\u0440\u044c\u0435\u0440\u0430 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435, \u043d\u043e \u0432\u043a\u0443\u0441\u043e\u0432\u044b\u0435 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f \u043e\u0442 \u0435\u0434\u044b \u043d\u0435 \u043f\u0440\u0435\u0432\u044b\u0441\u0438\u043b\u0438 \u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f, \u0447\u0442\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0441\u0442\u0430\u0442\u0443\u0441\u0443 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u044f.", {"\u0438\u043d\u0442\u0435\u0440\u044c\u0435\u0440\u0430": "Positive", "\u0432\u043a\u0443\u0441\u043e\u0432\u044b\u0435 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f \u043e\u0442 \u0435\u0434\u044b": "Neutral"}], ["\u0418\u043d\u0442\u0435\u0440\u044c\u0435\u0440 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430 \u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u044f, \u043d\u043e \u043a\u0443\u0445\u043d\u044f \u043d\u0435 \u0441\u043c\u043e\u0433\u043b\u0430 \u0443\u0434\u0438\u0432\u0438\u0442\u044c, \u043e\u0441\u0442\u0430\u0432\u0430\u044f\u0441\u044c \u043d\u0430 \u043f\u0440\u0438\u0435\u043c\u043b\u0435\u043c\u043e\u043c \u0443\u0440\u043e\u0432\u043d\u0435 \u0434\u043b\u044f \u0434\u0430\u043d\u043d\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u0430.", {"\u0418\u043d\u0442\u0435\u0440\u044c\u0435\u0440 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0430": "Positive", "\u043a\u0443\u0445\u043d\u044f": "Neutral"}], ["\u041e\u0442\u043b\u0438\u0447\u043d\u044b\u0435 \u0442\u043e\u0432\u0430\u0440\u044b!", {"\u0442\u043e\u0432\u0430\u0440\u044b": "Positive"}], ["\u0423\u0436\u0430\u0441\u043d\u044b\u0435 \u0442\u043e\u0432\u0430\u0440\u044b!", {"\u0442\u043e\u0432\u0430\u0440\u044b": "Negative"}], ["\u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435 \u0442\u043e\u0432\u0430\u0440\u044b.", {"\u0442\u043e\u0432\u0430\u0440\u044b": "Neutral"}]]