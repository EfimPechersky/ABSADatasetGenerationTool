[["\u041a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u043a\u043e\u0444\u0435 \u0432 \u044d\u0442\u043e\u043c \u043a\u0430\u0444\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u043b\u0438\u0447\u043d\u043e\u0435, \u043d\u043e \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u043c\u043e\u0433\u043b\u043e \u0431\u044b \u0431\u044b\u0442\u044c \u0431\u043e\u043b\u0435\u0435 \u0432\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c.", {"\u041a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u043a\u043e\u0444\u0435": "Positive", "\u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435": "Negative"}], ["\u041a\u043e\u0444\u0435 \u0432 \u044d\u0442\u043e\u043c \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u0435\u043d, \u0430 \u0430\u043f\u043f\u0435\u0442\u0438\u0442\u043d\u044b\u0439 \u0441\u0443\u043f \u0434\u0435\u043b\u0430\u0435\u0442 \u0432\u0438\u0437\u0438\u0442 \u043d\u0435\u0437\u0430\u0431\u044b\u0432\u0430\u0435\u043c\u044b\u043c.", {"\u0441\u0443\u043f": "Positive"}], ["\u041e\u0442\u043c\u0435\u043d\u043d\u044b\u0439 \u043a\u043e\u0444\u0435 \u0438 \u0432\u043a\u0443\u0441\u043d\u0435\u0439\u0448\u0438\u0439 \u0441\u0443\u043f \u0441\u043e\u0437\u0434\u0430\u044e\u0442 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435 \u043e \u043a\u0430\u0444\u0435.", {"\u043a\u043e\u0444\u0435": "Positive", "\u0441\u0443\u043f": "Positive"}], ["\u041a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u043a\u043e\u0444\u0435\u0439\u043d\u044b\u0445 \u043d\u0430\u043f\u0438\u0442\u043a\u043e\u0432 \u043d\u0430 \u0432\u044b\u0441\u043e\u0442\u0435, \u0430 \u0441\u0443\u043f \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f \u043e\u0442 \u043f\u0440\u0435\u0431\u044b\u0432\u0430\u043d\u0438\u044f.", {"\u043a\u043e\u0444\u0435\u0439\u043d\u044b\u0445 \u043d\u0430\u043f\u0438\u0442\u043a\u043e\u0432": "Positive", "\u0441\u0443\u043f": "Positive"}], ["\u0412 \u044d\u0442\u043e\u043c \u043a\u0430\u0444\u0435 \u043a\u043e\u0444\u0435 \u043d\u0435\u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e \u0445\u043e\u0440\u043e\u0448, \u0430 \u0441\u0443\u043f \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e \u0434\u043e\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0432\u043a\u0443\u0441\u043e\u0432\u0443\u044e \u0433\u0430\u043c\u043c\u0443.", {"\u043a\u043e\u0444\u0435": "Positive", "\u0441\u0443\u043f": "Positive"}], ["\u041a\u043e\u0444\u0435\u0439\u043d\u044b\u0435 \u043d\u0430\u043f\u0438\u0442\u043a\u0438 \u0432 \u043a\u0430\u0444\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u043e\u0441\u0445\u0438\u0442\u0438\u0442\u0435\u043b\u044c\u043d\u044b, \u0430 \u0441\u0443\u043f \u0443\u0441\u0438\u043b\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u044d\u043c\u043e\u0446\u0438\u0438.", {"\u041a\u043e\u0444\u0435\u0439\u043d\u044b\u0435 \u043d\u0430\u043f\u0438\u0442\u043a\u0438": "Positive", "\u0441\u0443\u043f": "Positive"}], ["\u041a\u0430\u0436\u0434\u044b\u0439 \u0433\u043b\u043e\u0442\u043e\u043a \u043a\u043e\u0444\u0435 \u0432 \u044d\u0442\u043e\u043c \u043c\u0435\u0441\u0442\u0435 - \u0438\u0441\u0442\u0438\u043d\u043d\u043e\u0435 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435, \u0430 \u0441\u0443\u043f \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u043a\u0430\u0440\u0442\u0438\u043d\u0443.", {"\u043a\u043e\u0444\u0435": "Positive", "\u0441\u0443\u043f": "Positive"}], ["\u041a\u043e\u0444\u0435 \u0437\u0434\u0435\u0441\u044c - \u0432\u044b\u0448\u0435 \u0432\u0441\u0435\u0445 \u043f\u043e\u0445\u0432\u0430\u043b, \u0430 \u0441\u0443\u043f \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0435 \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f.", {"\u041a\u043e\u0444\u0435": "Positive", "\u0441\u0443\u043f": "Positive"}], ["\u042d\u0441\u043f\u0440\u0435\u0441\u0441\u043e \u0432 \u044d\u0442\u043e\u043c \u043a\u0430\u0444\u0435 - \u043e\u0431\u0440\u0430\u0437\u0435\u0446 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430, \u0430 \u0441\u0443\u043f \u0434\u0435\u043b\u0430\u0435\u0442 \u043e\u0431\u0435\u0434 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u043c.", {"\u042d\u0441\u043f\u0440\u0435\u0441\u0441\u043e": "Positive", "\u0441\u0443\u043f": "Positive"}], ["\u041d\u0435\u0436\u043d\u044b\u0439 \u0432\u043a\u0443\u0441 \u043a\u043e\u0444\u0435 \u0438 \u0438\u0437\u044b\u0441\u043a\u0430\u043d\u043d\u044b\u0439 \u0441\u0443\u043f \u0434\u0435\u043b\u0430\u044e\u0442 \u044d\u0442\u043e \u043a\u0430\u0444\u0435 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0439 \u043d\u0430\u0445\u043e\u0434\u043a\u043e\u0439.", {"\u043a\u043e\u0444\u0435": "Positive", "\u0441\u0443\u043f": "Positive"}], ["\u041a\u043e\u0444\u0435\u0439\u043d\u044b\u0435 \u043d\u0430\u043f\u0438\u0442\u043a\u0438 \u0432 \u0437\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u043f\u0440\u0435\u0432\u043e\u0441\u0445\u043e\u0434\u043d\u044b, \u0430 \u0441\u0443\u043f - \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0433\u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0435\u043d\u0438\u0435.", {"\u041a\u043e\u0444\u0435\u0439\u043d\u044b\u0435 \u043d\u0430\u043f\u0438\u0442\u043a\u0438": "Positive", "\u0441\u0443\u043f": "Positive"}], ["\u041e\u0444\u0438\u0446\u0438\u0430\u043d\u0442\u044b \u0432 \u043a\u0430\u0444\u0435 \u043d\u0435 \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u044e\u0442 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0433\u0438\u0433\u0438\u0435\u043d\u044b.", {"\u0433\u0438\u0433\u0438\u0435\u043d\u044b": "Negative"}], ["\u0423\u0431\u043e\u0440\u043a\u0430 \u0432 \u043a\u0430\u0444\u0435 \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0442\u0449\u0430\u0442\u0435\u043b\u044c\u043d\u043e, \u0447\u0442\u043e \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u043e\u043f\u0430\u0441\u0435\u043d\u0438\u044f.", {"\u0423\u0431\u043e\u0440\u043a\u0430": "Negative"}], ["\u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b \u043a\u0430\u0444\u0435 \u043d\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u044f \u0447\u0438\u0441\u0442\u043e\u043f\u043b\u043e\u0442\u043d\u043e\u0441\u0442\u0438.", {"\u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b": "Negative"}], ["\u041a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u0432 \u043a\u0430\u0444\u0435 \u043f\u043e\u0434\u0432\u043e\u0434\u0438\u0442 \u0438\u0437-\u0437\u0430 \u043d\u0435\u0430\u043a\u043a\u0443\u0440\u0430\u0442\u043d\u043e\u0441\u0442\u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432.", {"\u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u044f": "Negative", "\u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432": "Negative"}], ["\u041e\u0431\u0440\u0430\u0442\u0438\u043b \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435, \u0447\u0442\u043e \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0438 \u043a\u0430\u0444\u0435 \u043d\u0435 \u0441\u043b\u0435\u0434\u044f\u0442 \u0437\u0430 \u043b\u0438\u0447\u043d\u043e\u0439 \u0433\u0438\u0433\u0438\u0435\u043d\u043e\u0439.", {"\u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0438": "Negative", "\u0433\u0438\u0433\u0438\u0435\u043d\u043e\u0439": "Negative"}], ["\u0427\u0438\u0441\u0442\u043e\u0442\u0430 \u0432 \u043a\u0430\u0444\u0435 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0436\u0435\u043b\u0430\u0442\u044c \u043b\u0443\u0447\u0448\u0435\u0433\u043e, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0441\u0440\u0435\u0434\u0438 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0430.", {"\u0427\u0438\u0441\u0442\u043e\u0442\u0430": "Negative", "\u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0430": "Negative"}], ["\u0421\u0430\u043d\u0438\u0442\u0430\u0440\u043d\u044b\u0435 \u043d\u043e\u0440\u043c\u044b \u0432 \u043a\u0430\u0444\u0435, \u043a \u0441\u043e\u0436\u0430\u043b\u0435\u043d\u0438\u044e, \u043d\u0435 \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u044e\u0442\u0441\u044f.", {"\u043d\u043e\u0440\u043c\u044b": "Negative"}], ["\u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b \u043a\u0430\u0444\u0435 \u043c\u043e\u0433 \u0431\u044b \u0443\u0434\u0435\u043b\u0438\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f \u043b\u0438\u0447\u043d\u043e\u0439 \u0433\u0438\u0433\u0438\u0435\u043d\u0435.", {"\u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b": "Negative", "\u0433\u0438\u0433\u0438\u0435\u043d\u0435": "Negative"}], ["\u0412\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435 \u043e\u0442 \u043a\u0430\u0444\u0435 \u043f\u043e\u0440\u0442\u0438\u0442 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0433\u0438\u0433\u0438\u0435\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043e\u0432 \u0443 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432.", {"\u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043e\u0432": "Negative", "\u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432": "Negative"}], ["\u041d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0430\u044f \u0433\u0438\u0433\u0438\u0435\u043d\u0430 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0430 \u043e\u043c\u0440\u0430\u0447\u0430\u0435\u0442 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u0435\u043d\u0438\u0435 \u043e\u0442 \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u044f \u043a\u0430\u0444\u0435.", {"\u0433\u0438\u0433\u0438\u0435\u043d\u0430": "Negative"}], ["\u041e\u0442\u043b\u0438\u0447\u043d\u044b\u0435 \u0442\u043e\u0432\u0430\u0440\u044b!", {"\u0442\u043e\u0432\u0430\u0440\u044b": "Positive"}], ["\u0423\u0436\u0430\u0441\u043d\u044b\u0435 \u0442\u043e\u0432\u0430\u0440\u044b!", {"\u0442\u043e\u0432\u0430\u0440\u044b": "Negative"}], ["\u041d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u044b\u0435 \u0442\u043e\u0432\u0430\u0440\u044b.", {"\u0442\u043e\u0432\u0430\u0440\u044b": "Neutral"}]]